# Cloudflare Pages Headers Configuration

# Default cache rules and security headers for HTML and root files
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

# HTML files - always revalidate for fresh content deployment
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Static Vite assets with hash fingerprints - immutable cache (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# PDF, images, fonts and favicon
/_GAIA_DALESSIO_CV_.pdf
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Disposition: inline; filename="Gaia_DAlessio_CV.pdf"

/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
